---
# LLVM defaults, overridden only where the house style differs: 4-space indent,
# 100-column lines, `Type* ptr`, un-indented namespaces, indented case labels.
# Everything else — include sorting, trailing-comment alignment, and the
# one-liner rules — is left at LLVM's defaults on purpose.
#
# The whole tree was formatted with this config in one sweep, so it should stay
# clean; `clang-format -i` on files you touch is enough to keep it that way.
# Vendored code is excluded via .clang-format-ignore.
#
# Known wart: include/roxy/compiler/ir/ssa_ir.hpp does not reach a fixed point.
# Its wrapped trailing comments in the IROp enum oscillate between two
# alignments on successive runs (a clang-format bug in AlignTrailingComments
# over wrapped comments), so a `--dry-run` check will always flag that file.
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: true

PointerAlignment: Left
ReferenceAlignment: Left
